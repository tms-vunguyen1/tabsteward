{
  "description": "tabsteward guard: blocks raw Chrome access, asks before browser changes, protects the policy.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" user-prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
